# Synthetic config-rendering values only. NEVER use for a running deployment.
# Store real values in Coolify runtime settings, never this directory.
# Do not enable build-time availability for any runtime setting.
ARKX_CANDIDATE_ID=validation-only
POSTGRES_USER=postiz
POSTGRES_PASSWORD=validation-only-not-a-real-password
POSTGRES_DB=postiz
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=validation-only-not-a-real-password

# Production file only. ARKX_RUNTIME must be the literal value production.
# Synthetic commit for rendering only; replace with the published deployment commit.
SOURCE_COMMIT=0000000000000000000000000000000000000000
# Deliberately blocks the startup wrapper even when production profile is selected.
ARKX_RUNTIME=rehearsal
ARKX_PUBLIC_URL=https://localhost
JWT_SECRET=validation-only-not-a-real-secret
FACEBOOK_APP_ID=validation-only
FACEBOOK_APP_SECRET=validation-only
LINKEDIN_CLIENT_ID=validation-only
LINKEDIN_CLIENT_SECRET=validation-only
YOUTUBE_CLIENT_ID=validation-only
YOUTUBE_CLIENT_SECRET=validation-only
