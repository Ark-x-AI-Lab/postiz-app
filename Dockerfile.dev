FROM node:22.23.4-bookworm-slim AS dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

# Copy a directory of the installed symlinks, not individual COPY sources that
# may be dereferenced. Keep their exact targets alongside the global packages.
RUN mkdir -p /runtime-bin \
 && cp -a /usr/local/bin/pnpm /usr/local/bin/pnpx \
    /usr/local/bin/pm2 /usr/local/bin/pm2-dev \
    /usr/local/bin/pm2-docker /usr/local/bin/pm2-runtime /runtime-bin/

WORKDIR /app

# Cache only public dependency inputs and fetched packages, without app source.
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch --frozen-lockfile --ignore-scripts --store-dir=/pnpm/store

FROM dependencies AS builder
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

# Fetch leaves dependency scripts pending. Materialize only approved native builds,
# without replaying the workspace's already-run project hooks.
RUN pnpm install --offline --frozen-lockfile --store-dir=/pnpm/store \
 && pnpm rebuild bcrypt canvas --store-dir=/pnpm/store
# Bundle the schema engine while build-time network access is available.
RUN pnpm exec prisma --version
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build
# Verified build-only cache; retain compiled server/static output and runtime caches.
RUN rm -rf /app/apps/frontend/.next/cache/turbopack

FROM node:22.23.4-bookworm-slim AS runtime
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION

# Native Node modules and Prisma need runtime libraries, not the build tools.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    nginx \
    libstdc++6 \
    libssl3 \
 && rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

COPY --from=builder /usr/local/lib/node_modules/pnpm/ /usr/local/lib/node_modules/pnpm/
COPY --from=builder /usr/local/lib/node_modules/pm2/ /usr/local/lib/node_modules/pm2/
COPY --from=builder /runtime-bin/ /usr/local/bin/

WORKDIR /app
COPY --from=builder /app/ /app/
COPY --from=builder /etc/nginx/nginx.conf /etc/nginx/nginx.conf

CMD ["sh", "-c", "nginx && pnpm run pm2"]
